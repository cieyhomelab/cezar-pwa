{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    // Type-check only: `build.mjs` bundles src/index.ts into one file with esbuild, so the host
    // runs it with no node_modules and no workspace link to @cezar-pwa/shared.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../packages/shared/tsconfig.build.json"
    }
  ]
}
