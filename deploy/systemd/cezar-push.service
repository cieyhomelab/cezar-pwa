# User unit, installed by deploy/push/install.sh (run on the VPS as the user
# Cezar runs as). The installer RENDERS this file, replacing the two
# %h-relative directories below with CEZAR_PUSH_HOME and STATE_DIR, and
# refuses to install a unit in which it could not set both — so if you move a
# path around, keep it spelled relative to those two. A hand copy is not
# rendered and therefore only works with the defaults:
#   cp deploy/systemd/cezar-push.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cezar-push
#   loginctl enable-linger $USER   # so it survives logout
[Unit]
Description=cezar-push — Web Push sidecar for Cezar Mobile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cezar-push
# One bundled file (apps/push-sidecar/build.mjs): no node_modules on the host.
ExecStart=/usr/bin/node %h/cezar-push/cezar-push.mjs
Restart=always
RestartSec=5

# Loopback only — nginx is the sole way in (A5/A6). PORT can be moved in the
# env file below; the installer's health probe reads whichever wins. HOST
# cannot, by design.
Environment=HOST=127.0.0.1
Environment=PORT=4330
# Cezar's own port on this host (`cezar-cli serve --port 4322`), on loopback,
# where it answers without the gate's cookie.
Environment=CEZAR_URL=http://127.0.0.1:4322
# The VAPID keys and the subscriptions live in %h/.cezar-push (files 0600),
# never in the repo (CLAUDE.md rule 6). The directory is 0700 because the
# installer's `install -d -m 700` makes it so — the sidecar sets that mode when
# it creates the directory, but leaves an existing looser one alone.
# PUBLIC_ORIGIN — the https:// origin the app is served from, e.g.
# https://cezar.example.com, with no trailing slash — is REQUIRED and has no
# default: the sidecar refuses to start without it, rather than start and then
# 403 every write from the real origin. The installer keeps it in the env file
# below. VAPID_SUBJECT defaults to it; a mailto: contact can be set there too.
Environment=STATE_DIR=%h/.cezar-push
# Usage-limits collector (GET /m/push/limits, #92). Codex is read through
# `codex app-server`, looked up on PATH and in ~/.local/bin (where Cezar's own
# unit finds its CLIs); set LIMITS_CODEX_BIN in the env file below for any
# other location. It reports "codex not installed" when neither has it. Claude is OFF by default: turning it on makes the sidecar read the
# OAuth token from ~/.claude/.credentials.json and call Anthropic's
# undocumented usage endpoint — set LIMITS_CLAUDE=1 in the env file below only
# if you accept that. The poll interval is in seconds, at least 60.
Environment=LIMITS_CODEX=1
Environment=LIMITS_CLAUDE=0
Environment=LIMITS_POLL_SECONDS=300
EnvironmentFile=-%h/.cezar-push/env

# journald only; the sidecar never logs task content (§6).
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
