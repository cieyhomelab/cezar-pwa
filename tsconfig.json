{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vitest.config.ts", "playwright.config.ts", "test"]
}
