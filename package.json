{
  "name": "cezar-pwa",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cezar-pwa/pwa",
    "build": "npm run build -w @cezar-pwa/shared && npm run build -w @cezar-pwa/push-sidecar && npm run build -w @cezar-pwa/pwa",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "scripts/deploy.sh",
    "sync:contract": "scripts/sync-contract.sh",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
